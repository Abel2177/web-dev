# Addis Eats — Environment Variables
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must NEVER be committed.

# ── Auth / Session ─────────────────────────────────────────────────────────────
# Secret used to sign the iron-session cookie. Must be ≥ 32 chars.
SESSION_SECRET=your-super-secret-session-key-at-least-32-chars

# ── API ────────────────────────────────────────────────────────────────────────
# Base URL for the local proxy / external recipes API
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Public canonical URL used by metadata, sitemap, and robots. Set this to the
# production Vercel URL before deploying.
NEXT_PUBLIC_SITE_URL=https://your-addis-eats.vercel.app

# ── Analytics ──────────────────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID (loaded via next/script lazyOnload)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Database (future) ──────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/addis_eats
